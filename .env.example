# nass-document-platform - environment template (placeholders only; never commit real values).
#
# WHERE THIS FILE MUST GO: copy it to  nass\.env   (git-ignored).
#   Nass reads nass/.env at start-up (lab/core/auto/config.py, DEFAULT_DOTENV = <nass>/.env);
#   AGENTICDOC_ENV_FILE=<path> selects a different file. Variables already set in the real
#   environment always win. Studio and DocPrep read no .env file: Studio passes its environment
#   on to the Nass subprocess, and DocPrep needs no secrets or service settings.
#
# Minimum for new extractions through Studio (see docs/RUNPOD_SETUP.md and README):
#   LAYOUT_MODEL_DIR       local PP-DocLayout_plus-L_infer folder (Studio refuses to extract without it)
#   QARI_SERVICE_URL       Qari endpoint (Studio refuses to extract without it, even for digital PDFs)
#   QARI_DEPLOYMENT_MODE   local | internal | development_external (RunPod needs QARI_TRUSTED_DEV_HOSTS)
#   QARI_SERVICE_TOKEN     bearer token shared with the Qari service (never commit it)
#

# --- app
AGENTICDOC_ENV=local                      # local | staging | production (production: local/internal Qari only)
# AGENTICDOC_AUTO_CONFIG=lab/config/auto_extraction.toml
# AGENTICDOC_RESULTS_DIR=D:\agenticdoc_e2\results
AGENTICDOC_MAX_PDF_MB=200
AGENTICDOC_MAX_PAGES=500

# --- layout (local PP-DocLayout_plus-L, CPU or GPU; never downloaded by the app)
# Windows example (the unpacked *_infer folder with inference.yml / inference.pdiparams):
# LAYOUT_MODEL_DIR=C:\Users\<you>\models\PP-DocLayout_plus-L_infer
# Linux example:
# LAYOUT_MODEL_DIR=/models/PP-DocLayout_plus-L_infer
LAYOUT_DEVICE=cpu
# LAYOUT_SCORE_THRESHOLD=0.5
LAYOUT_SELECTION_POLICY=confident_only
LAYOUT_PAGE_RENDER_DPI=200
# Digital/mixed figure crops: native image bytes only for a clean single layer at >= this DPI, else 250 DPI render
LAYOUT_NATIVE_MIN_DPI=200
LAYOUT_NATIVE_BBOX_TOLERANCE_PT=2
LAYOUT_CROP_QUALITY_MIN_STD=3

# --- Qari service client (endpoint trust is set here by the administrator; no user approval)
# Pick ONE deployment:
#   1) local (Qari on this machine, or an SSH tunnel to it):
#        QARI_DEPLOYMENT_MODE=local
#        QARI_SERVICE_URL=http://127.0.0.1:8000
#   2) internal company GPU server:
#        QARI_DEPLOYMENT_MODE=internal
#        QARI_SERVICE_URL=https://qari.gpu.internal.example:8000
#   3) RunPod development service (https; the exact host must be listed):
#        QARI_DEPLOYMENT_MODE=development_external
#        QARI_SERVICE_URL=https://<pod-id>-8000.proxy.runpod.net
#        QARI_TRUSTED_DEV_HOSTS=<pod-id>-8000.proxy.runpod.net
QARI_DEPLOYMENT_MODE=local
# QARI_SERVICE_URL=http://127.0.0.1:8000
# QARI_TRUSTED_DEV_HOSTS=
QARI_AUTOMATIC_ENABLED=true
QARI_SERVICE_TOKEN=<set-a-long-random-token>
QARI_REQUEST_TIMEOUT_S=180
QARI_MAX_CONNECT_RETRIES=2
QARI_CONCURRENCY=1
# QARI_MAX_IMAGE_PIXELS=          # empty = native pixels (no resizing)

# --- processing / validation
PROCESSING_ON_FAILURE=continue
PROCESSING_MAX_JOBS=2000
VALIDATION_REVIEW_POLICY=flag
# Report-only second read of crops with Arabic-Indic/Persian digits (one extra Qari request per crop)
VERIFY_DIGITS_ENABLED=true
VERIFY_DIGITS_MAX_REQUESTS=30
VERIFY_DIGITS_UPSCALE=1.5
AUTO_ALLOW_PROVEN_OVERRIDES=false

# --- Qari service (GPU host, runpod/qari_service.py)
# QARI_SERVICE_TOKEN=<same token as the client>
# QARI_DEVICE_MAP=auto
# QARI_DTYPE=float16
# QARI_SERVICE_CONCURRENCY=1
# QARI_SERVICE_MAX_QUEUE=8
# QARI_SERVICE_MAX_IMAGE_MB=40
# QARI_SERVICE_RESULT_CACHE=256
# QARI_MODEL_CACHE_DIR=/models/hf
# QARI_ALLOW_PROVEN_OVERRIDES=false
# QARI_PROVEN_OVERRIDES={"max_new_tokens": 1536}
